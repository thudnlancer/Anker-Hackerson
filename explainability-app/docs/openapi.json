  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "charge",
              "discharge",
              "hold"
            ],
            "title": "Kind"
          },
          "power_kw": {
            "type": "number",
            "minimum": 0.0,
            "title": "Power Kw"
          },
          "control_semantics": {
            "type": "string",
            "enum": [
              "battery_charge",
              "grid_charge",
              "grid_export_target",
              "self_consumption",
              "external"
            ],
            "title": "Control Semantics"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "power_kw",
          "control_semantics"
        ],
        "title": "Action"
      },
      "Cost": {
        "properties": {
          "purchase_eur": {
            "type": "number",
            "title": "Purchase Eur"
          },
          "export_revenue_eur": {
            "type": "number",
            "title": "Export Revenue Eur"
          },
          "degradation_eur": {
            "type": "number",
            "minimum": 0.0,
            "title": "Degradation Eur"
          },
          "terminal_credit_eur": {
            "type": "number",
            "title": "Terminal Credit Eur"
          },
          "objective_eur": {
            "type": "number",
            "title": "Objective Eur"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "purchase_eur",
          "export_revenue_eur",
          "degradation_eur",
          "terminal_credit_eur",
          "objective_eur"
        ],
        "title": "Cost"
      },
      "DecisionIn": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "run_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Run Id"
          },
          "site_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Site Id"
          },
          "decision_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Decision Id"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "demo",
              "external"
            ],
            "title": "Source Kind"
          },
          "snapshot": {
            "$ref": "#/components/schemas/Snapshot"
          },
          "action": {
            "$ref": "#/components/schemas/Action"
          },
          "model_version": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Model Version"
          },
          "policy_version": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Policy Version"
          },
          "solver_status": {
            "type": "string",
            "enum": [
              "optimal",
              "feasible",
              "fallback",
              "failed",
              "unknown"
            ],
            "title": "Solver Status"
          },
          "cost": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Cost"
              },
              {
                "type": "null"
              }
            ]
          },
          "replay_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ReplayContext"
              },
              {
                "type": "null"
              }
            ]
          },
          "provenance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Provenance"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "run_id",
          "site_id",
          "decision_id",
          "source_kind",
          "snapshot",
          "action",
          "model_version",
          "policy_version",
          "solver_status"
        ],
        "title": "DecisionIn"
      },
      "ExecutionEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Event Id"
          },
          "instruction_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Instruction Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "submitted",
              "confirmed",
              "failed"
            ],
            "title": "Kind"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time",
            "title": "Issued At"
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          },
          "device_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device Time"
          },
          "observed_mode": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed Mode"
          },
          "observed_power_kw": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed Power Kw"
          },
          "note": {
            "type": "string",
            "maxLength": 1000,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "instruction_id",
          "kind",
          "issued_at"
        ],
        "title": "ExecutionEvent"
      },
      "FirstStep": {
        "properties": {
          "charge_kw": {
            "type": "number",
            "minimum": 0.0,
            "title": "Charge Kw"
          },
          "discharge_kw": {
            "type": "number",
            "minimum": 0.0,
            "title": "Discharge Kw"
          },
          "grid_import_kw": {
            "type": "number",
            "minimum": 0.0,
            "title": "Grid Import Kw"
          },
          "grid_export_kw": {
            "type": "number",
            "minimum": 0.0,
            "title": "Grid Export Kw"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "charge_kw",
          "discharge_kw",
          "grid_import_kw",
          "grid_export_kw"
        ],
        "title": "FirstStep"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Intervention": {
        "properties": {
          "first_charge_kw": {
            "type": "number",
            "minimum": 0.0,
            "title": "First Charge Kw"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "first_charge_kw"
        ],
        "title": "Intervention"
      },
      "Provenance": {
        "properties": {
          "origin": {
            "type": "string",
            "enum": [
              "external_adapter",
              "historical_log",
              "model_validation"
            ],
            "title": "Origin"
          },
          "input_kind": {
            "type": "string",
            "enum": [
              "observed",
              "mixed",
              "synthetic",
              "incomplete"
            ],
            "title": "Input Kind"
          },
          "references": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "References"
          },
          "note": {
            "type": "string",
            "maxLength": 2000,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "origin",
          "input_kind"
        ],
        "title": "Provenance"
      },
      "Question": {
        "properties": {
          "decision_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Decision Id"
          },
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision_id",
          "question"
        ],
        "title": "Question"
      },
      "ReplayContext": {
        "properties": {
          "upstream_source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Upstream Source Sha256"
          },
          "command_contract": {
            "type": "string",
            "enum": [
              "battery",
              "sop"
            ],
            "title": "Command Contract"
          },
          "first_step": {
            "$ref": "#/components/schemas/FirstStep"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "upstream_source_sha256",
          "command_contract",
          "first_step"
        ],
        "title": "ReplayContext"
      },
      "SettlementIn": {
        "properties": {
          "event_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Event Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "complete"
            ],
            "title": "Status"
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "demo",
              "official"
            ],
            "title": "Source Kind"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time",
            "title": "Captured At"
          },
          "window_start": {
            "type": "string",
            "format": "date-time",
            "title": "Window Start"
          },
          "window_end": {
            "type": "string",
            "format": "date-time",
            "title": "Window End"
          },
          "saving_settled_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Saving Settled Percent"
          },
          "saving_settled_eur": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Saving Settled Eur"
          },
          "raw_fields": {
            "additionalProperties": true,
            "type": "object",
            "title": "Raw Fields"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "status",
          "source_kind",
          "captured_at",
          "window_start",
          "window_end"
        ],
        "title": "SettlementIn"
      },
      "Snapshot": {
        "properties": {
          "device_time": {
            "type": "string",
            "format": "date-time",
            "title": "Device Time"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          },
          "soc_percent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Soc Percent"
          },
          "pv_kw": {
            "type": "number",
            "minimum": 0.0,
            "title": "Pv Kw"
          },
          "load_kw": {
            "type": "number",
            "minimum": 0.0,
            "title": "Load Kw"
          },
          "capacity_kwh": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Capacity Kwh"
          },
          "max_charge_kw": {
            "type": "number",
            "minimum": 0.0,
            "title": "Max Charge Kw"
          },
          "max_discharge_kw": {
            "type": "number",
